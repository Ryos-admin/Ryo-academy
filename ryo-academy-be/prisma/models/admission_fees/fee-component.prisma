model FeeComponent {
    id String @id @default(uuid())
    name String
    description String?
    amount Decimal
    feeStructureId String
    feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
    discountApplicable Boolean @default(false)
    isMandatory Boolean @default(true)
    isActive Boolean @default(true)
    deletedAt DateTime?
    deletedById String?
    deletedBy User? @relation("FeeComponentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    feePaymentDetails FeePaymentDetails[]

    @@unique([feeStructureId, name])
    @@index([feeStructureId])
}