enum AdmissionStatus {
    DRAFT
    CONFIRMED
    CANCELLED
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum Relation {
    FATHER
    MOTHER
    GUARDIAN
}

model Admission {
    id String @id @default(uuid())
    //ADMISSION NUMBER 
    admissionNumber String @unique
    admissionSequence Int// @default(autoincrement())
    admissionStatus AdmissionStatus @default(DRAFT)

    // ACADEMIC DETAILS
    schoolId        String
    schoolCode      School @relation(fields:[schoolId], references: [id])
    academicYearId String
    academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
    programId String 
    program Program @relation(fields: [programId], references: [id])
    classId String
    class Class @relation(fields: [classId], references: [id])
    sectionId String
    section Section @relation(fields: [sectionId], references: [id])

    // STUDENT DETAILS
    studentName String
    gender Gender
    dateOfBirth DateTime

    //PARENT DETAILS
    parentName String?
    parentRelation Relation?
    parentPhone String?
    parentAlternatePhone String?
    parentEmail String?

    // ADDRESS DETAILS
    addressLine1 String?
    addressLine2 String?
    city String?
    state String?
    pincode String?
    country String? @default("India")

    // DISCOUNT DETAILS
    discountPercentage Decimal @default(0)
    discountReason String?

    isActive Boolean @default(true)
    deletedAt DateTime?

    // CONFIRMATION DETAILS
    studentId String?
    createdById String
    confirmedById String?
    cancelledById String?
    confirmedAt DateTime?
    cancelledAt DateTime?
    cancellationReason String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    feePaymentHeaders FeePaymentHeader[]
    feePayments FeePayment[]

    student Student?
    
    // An admission is one student's placement. A class legitimately holds many
    // students (and many admissions) per academic year, so there is no uniqueness
    // on (academicYearId, programId, classId) here.
    // The real boundaries are:
    //   - admissionNumber  -> unique per admission (@unique above)
    //   - Student.admissionId -> unique, so a student maps to one admission
    // The index below is kept because it backs the per-class lookups.
    @@index([academicYearId, programId, classId])
}
