model FeePaymentDetails {
    id String @id @default(uuid())
    feePaymentHeaderId String
    feePaymentHeader FeePaymentHeader @relation(fields: [feePaymentHeaderId], references: [id])
    feeComponentId String
    feeComponent FeeComponent @relation(fields: [feeComponentId], references: [id])

    nameSnapshot String

    isActive Boolean @default(true)
    isIncluded Boolean @default(true)

    originalAmount Decimal
    discountApplicable Boolean
    isMandatory Boolean
    discountAmount Decimal
    finalAmount Decimal
    totalAmountToBePaid Decimal
    amountPaid Decimal
    paymentDate DateTime
    concession AdmissionFeeConcession?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    detailAttributions FeePaymentDetailAttribution[] @relation("DetailAttributions")

    @@unique([feePaymentHeaderId, feeComponentId])
    @@unique([id, feePaymentHeaderId], name: "uq_detail_id_header")
    @@index([feePaymentHeaderId, feeComponentId])
}
