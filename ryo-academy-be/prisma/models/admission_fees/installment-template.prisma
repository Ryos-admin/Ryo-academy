enum InstallmentCalculationType {
  CUSTOM_AMOUNT
  PERCENTAGE
  EQUAL_SPLIT
}

model InstallmentTemplate {
  id               String                     @id @default(uuid())
  schoolId         String
  name             String
  description      String?
  calculationType  InstallmentCalculationType
  installmentCount Int
  isActive         Boolean                    @default(true)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  school           School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  items            InstallmentTemplateItem[]
  schedules        AdmissionInstallmentSchedule[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
}

model InstallmentTemplateItem {
  id                    String              @id @default(uuid())
  templateId            String
  sequence              Int
  label                 String
  percentage            Decimal?            @db.Decimal(5, 2)
  fixedAmount           Decimal?            @db.Decimal(12, 2)
  dueDaysAfterAdmission Int
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  template              InstallmentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, sequence])
  @@index([templateId])
}
