model FeePaymentHeader {
  id String @id @default(uuid())
  admissionId String
  admission Admission @relation(fields: [admissionId], references: [id])
  // studentId String
  // student Student @relation(fields: [studentId], references: [id])
  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  feeStructureId String
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  grossAmount Decimal
  discountAmount Decimal
  netAmount Decimal
  totalPaidAmount Decimal
  totalDueAmount Decimal
  totalFeeAmount Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive Boolean @default(true)
  
  feePaymentDetails FeePaymentDetails[]
  payments FeePayment[]
  installmentSchedule AdmissionInstallmentSchedule?
  installmentAllocations FeePaymentInstallmentAllocation[]
  installments AdmissionInstallment[]
  detailAttributions FeePaymentDetailAttribution[] @relation("HeaderAttributions")

  @@unique([academicYearId, admissionId, feeStructureId])
  @@unique([id, admissionId], name: "uq_header_id_admission")
  @@index([academicYearId, admissionId, feeStructureId])
}
