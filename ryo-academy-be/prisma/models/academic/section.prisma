model Section {
  id String @id @default(uuid())

  name String

  classId String
  class   Class @relation(fields: [classId], references: [id])
  admissions Admission[]
  teachingAssignments TeachingAssignment[]
  attendanceLogMasters AttendanceLogMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive Boolean @default(true)
  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("SectionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([classId, name])
  @@index([classId])
  @@index([isActive, deletedAt])
  @@index([deletedById])
}
