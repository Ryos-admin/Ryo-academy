model TeachingAssignment {
    id String @id @default(uuid())
    staffId String?
    staff Staff? @relation(fields: [staffId], references: [id])
    historicalStaffId String?
    historicalStaff Staff? @relation("HistoricalTeachingAssignment", fields: [historicalStaffId], references: [id], onDelete: SetNull)
    subjectId String
    subject Subjects @relation(fields: [subjectId], references: [id])
    classId String
    class Class @relation(fields: [classId], references: [id])
    sectionId String
    section Section @relation(fields: [sectionId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isActive Boolean @default(true)
    deletedAt DateTime?
    deletedById String?
    deletedBy User? @relation("TeachingAssignmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
    @@index([deletedById])
}
