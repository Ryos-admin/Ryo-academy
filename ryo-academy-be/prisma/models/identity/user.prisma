model User {
  id           String   @id @default(uuid())
  email        String   @unique

  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles UserRole[]
  
  staff Staff? @relation("StaffUser") 
  @@index([isActive])
}
